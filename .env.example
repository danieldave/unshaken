# Copy to .env.local for local testing. NEVER commit real keys.
# On Vercel: Project → Settings → Environment Variables.

# AI (scam check, Essay Coach, translations)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Supabase (Scam Radar, Winners wall, Captains, translation cache)
# Supabase → Project Settings → API. Use the service_role key: it stays on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin PIN for /admin (6+ characters). Hashed compare; or store only the hash:
#   ADMIN_PIN=sha256:<hex of sha256("unshaken-pin:" + your PIN)>
ADMIN_PIN=
# Optional: separate secret for signing the admin login cookie (any long random text)
ADMIN_SESSION_SECRET=
# Legacy: long admin token (16+ chars) still accepted by the API and the login box
ADMIN_TOKEN=

# Deadline alerts (web push). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random string; Vercel sends it to the daily job (expire, digest, alerts, drafts)
CRON_SECRET=
# Your live address, e.g. https://unshaken.vercel.app
SITE_URL=

# Daily digest auto-post to a Telegram channel (create a bot with @BotFather, add it as channel admin)
TELEGRAM_BOT_TOKEN=
# @your_channel_username or the numeric id (-100…)
TELEGRAM_CHANNEL_ID=
# Language of the Telegram post: en, pcm, fr, yo, ha, ig, sw
DIGEST_LANG=en
# Max new drafts per daily run (default 8, also set in config/sources.json)
DRAFTS_PER_RUN=8
