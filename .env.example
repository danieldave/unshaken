# Copy to .env.local for local testing. NEVER commit real keys.
# On Vercel: Project → Settings → Environment Variables.

# AI (scam check, Essay Coach, translations)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Supabase (Scam Radar, Winners wall, Captains, translation cache)
# Supabase → Project Settings → API. Use the service_role key: it stays on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random password for /admin.html (at least 16 characters)
ADMIN_TOKEN=make-this-long-and-random-please
